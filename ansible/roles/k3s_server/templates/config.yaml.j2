node-ip: {{ ansible_host }}
advertise-address: {{ ansible_host }}
tls-san:
  - {{ ansible_host }}
  - {{ inventory_hostname }}
flannel-iface: {{ k3s_flannel_iface }}
cluster-cidr: {{ k3s_pod_cidr }}
# Dış erişim (Ingress, LoadBalancer) GitOps reposundan kurulacak
disable:
  - traefik
  - servicelb
write-kubeconfig-mode: "0600"
# Control plane'de uygulama pod'u çalışmaz; CPU ve RAM API server ile veritabanına kalır.
# k3s bu ayarı sadece node ilk kaydolurken uygular (mevcut node için tasks/main.yml'e bakın)
node-taint:
  - node-role.kubernetes.io/control-plane:NoSchedule
